{
  "name": "honeyleaf",
  "private": true,
  "version": "0.1.0",
  "description": "A cozy scrapbook diary that lives on a desk.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/build-fonts.mjs && node scripts/gen-textures.mjs && node scripts/build-stickers.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "predev:mock": "npm run assets",
    "dev:mock": "vite --mode mock",
    "api": "node scripts/dev/api.mjs",
    "prebuild": "npm run assets",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "node scripts/check-dist.mjs && node scripts/check-licenses.mjs",
    "package": "npm run build && npm run check && node scripts/build-schema.mjs && node scripts/package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "node scripts/dev/make-config.mjs && node scripts/dev/php.mjs server/tests/smoke.php",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "art": "node scripts/gen-art.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "fflate": "0.8.3",
    "motion": "14.0.0",
    "perfect-freehand": "1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/gochi-hand": "5.3.0",
    "@fontsource/indie-flower": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/sacramento": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fontkit": "2.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
