# Uploaded files: never served or run from here (the API reads them for their owner).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
