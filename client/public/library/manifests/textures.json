    "paper-grain": { "file": "textures/paper-grain.svg", "size": [256, 256], "scale": 1, "kind": "lightmap" },
    "leather": { "file": "textures/leather.svg", "size": [220, 220], "scale": 1, "kind": "lightmap" },
    "kraft": { "file": "textures/kraft.svg", "size": [260, 260], "scale": 1, "kind": "lightmap" },
    "linen": { "file": "textures/linen.svg", "size": [120, 120], "scale": 1, "kind": "lightmap" },
    "speckle": { "file": "textures/speckle.svg", "size": [240, 240], "scale": 1, "kind": "mask" }
  }
